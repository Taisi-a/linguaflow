# Скопируй в .env и заполни
DATABASE_URL=sqlite:///./linguaflow.db
# Для Postgres: postgresql+psycopg://linguaflow:linguaflow@localhost:5432/linguaflow

# Любая длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Ключ из Google AI Studio. Без ключа слова ищутся только в строках «слово — перевод»
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

TIMEZONE=Europe/Moscow
# true, когда сайт работает по HTTPS
COOKIE_SECURE=false
