# Скопируй в .env и заполни
DATABASE_URL=sqlite:///./linguaflow.db
# Для Postgres: postgresql+psycopg://linguaflow:linguaflow@localhost:5432/linguaflow

# Любая длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Какая модель ищет слова в заметках: ollama | gemini | openai | none
# Если модель недоступна, слова ищутся только в строках «слово — перевод»
LLM_PROVIDER=ollama

# Локальная модель: brew install ollama && ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Gemini (из России нужен VPN)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Любой OpenAI-совместимый сервис
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=

TIMEZONE=Europe/Moscow
# true, когда сайт работает по HTTPS
COOKIE_SECURE=false
